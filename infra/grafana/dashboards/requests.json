          "expr": "100 * (sum(rate({env=\"$env\", container=\"nginx\"} | json | __error__=\"\" | status >= 500 [$__auto])) or vector(0)) / sum(rate({env=\"$env\", container=\"nginx\"} | json | __error__=\"\" [$__auto]))",
