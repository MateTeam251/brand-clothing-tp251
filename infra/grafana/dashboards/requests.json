    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests/s by status class",
      "description": "2xx ok, 3xx redirects, 4xx client errors (incl. 401/404/429), 5xx server errors.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (class) (rate({env=\"$env\", container=\"nginx\"} | json | __error__=\"\" | label_format class=`{{ substr 0 1 .status }}xx` [$__auto]))",
          "editorMode": "code",
          "legendFormat": "{{class}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
