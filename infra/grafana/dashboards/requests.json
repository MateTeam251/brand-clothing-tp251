{
  "uid": "29f68f91-62df-4030-8a08-fa587443572c",
  "title": "Requests",
  "description": "RED view of the backend from nginx access logs: rate, errors, duration.",
  "tags": [
    "brand-clothing"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
