# Production image: built by CI (docker-build.yml), pushed to ECR, run by docker-compose.prod.yml.
# Keep the base/dependency part in sync with Dockerfile.dev.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

# settings.py creates /app/logs at startup; /app itself is root-owned.
# /app/staticfiles receives collectstatic output (served by WhiteNoise).
# A home directory, because gunicorn writes a control socket to $HOME at
# startup ("Control server error: Permission denied: '/home/app'" without it).
RUN useradd --system --uid 10001 --create-home --home-dir /home/app app \
    && mkdir -p /app/logs /app/staticfiles \
    && chown app:app /app/logs /app/staticfiles
USER app

# Static files are baked into the image. Settings only need a SECRET_KEY to load;
# this dummy value exists only in this build step, never at runtime.
RUN SECRET_KEY=collectstatic-only python manage.py collectstatic --noinput

EXPOSE 8000
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2"]
