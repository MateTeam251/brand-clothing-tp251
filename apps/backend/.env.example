# DOCKER COMPOSE
# Lets a plain `docker compose up` in apps/backend use docker-compose.dev.yml.
COMPOSE_FILE=docker-compose.dev.yml

# DJANGO
SECRET_KEY=your-secret-here
# Server: DEBUG=False
DEBUG=True
# Comma-separated. Empty is fine locally while DEBUG=True.
# Server example: ALLOWED_HOSTS=api.example.com
ALLOWED_HOSTS=
# Comma-separated, with scheme. Server example: CSRF_TRUSTED_ORIGINS=https://api.example.com
CSRF_TRUSTED_ORIGINS=
# Comma-separated frontend origins, with scheme
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public backend URL, no trailing slash. Used in emails and activation links.
SITE_URL=http://127.0.0.1:8000

# POSTGRES
POSTGRES_DB=brand_clothing_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# REDIS (Celery broker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# CART ANALYTICS (weekly report, Celery)
# Must be a PRIVATE bucket on the server, not the public media bucket.
# Locally the LocalStack media bucket is fine.
ANALYTICS_REPORTS_BUCKET=brand-clothing-media
ANALYTICS_REPORTS_PREFIX=reports/carts
CART_ABANDON_AFTER_HOURS=24

# EMAIL
# Local without SMTP credentials: django.core.mail.backends.console.EmailBackend (prints emails to the console)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=yourmail@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=yourmail@gmail.com
MANAGER_NOTIFICATION_EMAIL=manageremail@example.com
# Server only (staging/prod use SES via the instance role, no password):
# EMAIL_BACKEND=django_ses.SESBackend
# AWS_SES_REGION_NAME=eu-central-1

# PAYMENT WAYFORPAY
WAYFORPAY_MERCHANT_ACCOUNT=test_merch_n1
WAYFORPAY_SECRET_KEY=your-test-secret
WAYFORPAY_MERCHANT_DOMAIN=your-test-domain.example
WAYFORPAY_SERVICE_URL=https://your-test-domain.example/api/payments/wayforpay/callback/
WAYFORPAY_RETURN_URL=https://your-test-domain.example/payment/result

WAYFORPAY_API_URL=https://secure.wayforpay.com/pay
WAYFORPAY_CHECK_STATUS_URL=https://api.wayforpay.com/api

#LOCALSTACK
LOCALSTACK_AUTH_TOKEN=your-auth-token

# --- S3 / Storage ---
# Server: USE_LOCALSTACK=False (the default is True)
USE_LOCALSTACK=True

# LocalStack only. On the server do NOT set these (not even "test"):
# boto3 must fall back to the EC2 instance role for S3 and SES.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_STORAGE_BUCKET_NAME=brand-clothing-media
AWS_S3_REGION_NAME=eu-central-1
