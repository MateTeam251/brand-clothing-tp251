# Local development image, used by docker-compose.dev.yml.
# Source code is mounted into /app by compose, so it isn't copied here.
# Runs as root so commands like makemigrations can write into the mounted folder.
# Keep the base/dependency part in sync with Dockerfile.prod.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

EXPOSE 8000
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
